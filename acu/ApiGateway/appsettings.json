{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Path where devices.json is stored. Override via environment variable: DataPath=/data/devices.json
  "DataPath": "/data/devices.json",
  // Path where workflows.json is stored. Override via environment variable: WorkflowDataPath=/data/workflows.json
  "WorkflowDataPath": "/data/workflows.json",
  // Path where robot workflows are stored. Override: RobotWorkflowDataPath=/data/robot-workflows.json
  "RobotWorkflowDataPath": "/data/robot-workflows.json",
  "RobotMediaDataPath": "/data/robot-media",
  // ACU-wide settings (robot speech language). Override: AcuSettingsDataPath=/data/acu-settings.json
  "AcuSettingsDataPath": "/data/acu-settings.json"
}
