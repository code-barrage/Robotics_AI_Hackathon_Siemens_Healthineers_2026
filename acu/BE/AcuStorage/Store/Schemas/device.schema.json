{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "devices.json: object keyed by deviceId.",
  "type": "object",
  "additionalProperties": { "$ref": "#/definitions/Device" },
  "definitions": {
    "Device": {
      "type": "object",
      "required": ["deviceId", "name", "ip", "mac", "firmware", "destinations"],
      "properties": {
        "deviceId": { "type": "string" },
        "name": { "type": "string" },
        "ip": { "type": "string" },
        "mac": { "type": "string" },
        "firmware": { "type": "string" },
        "registeredAt": { "type": "string" },
        "status": { "enum": ["pending", "approved", "rejected"] },
        "lastSeen": { "type": "string" },
        "lastSeenLocation": { "type": ["string", "null"] },
        "online": { "type": "boolean" },
        "statusData": { "type": ["object", "null"] },
        "destinations": { "type": "array", "items": { "$ref": "#/definitions/Destination" } }
      }
    },
    "Destination": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "x": { "type": ["number", "null"] },
        "y": { "type": ["number", "null"] },
        "z": { "type": ["number", "null"] }
      }
    }
  }
}
