    "expo": "~54.0.0",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-video": "~3.0.16",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
